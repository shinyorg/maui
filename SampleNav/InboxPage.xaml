<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SampleNav"
             x:DataType="local:InboxViewModel"
             x:Class="SampleNav.InboxPage"
             Title="Inbox">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Each tab keeps its own back stack." />
        <Label Text="{Binding Status}" FontSize="12" TextColor="Gray" />
        <Button Text="Push Detail into THIS tab" Command="{Binding PushDetail}" />
    </VerticalStackLayout>
</ContentPage>
