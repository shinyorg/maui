<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SampleNav"
             xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Navigation"
             x:DataType="local:ModalViewModel"
             x:Class="SampleNav.ModalPage"
             Title="Modal">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="I am modal. Pushes from here land on the modal stack." />
        <Button Text="Push Detail (still modal)"
                shiny:Navigate.ViewModel="{x:Type local:DetailViewModel}" />
        <Button Text="Close" shiny:Navigate.Action="PopModal" />
    </VerticalStackLayout>
</ContentPage>
