<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SampleNav"
             xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Navigation"
             x:DataType="local:SettingsViewModel"
             x:Class="SampleNav.SettingsPage"
             Title="Settings">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Settings" FontSize="18" />
        <Button Text="Open flyout" shiny:Navigate.Action="OpenFlyout" />
        <Button Text="Rebuild the declared root" Command="{Binding Restore}" />
    </VerticalStackLayout>
</ContentPage>
