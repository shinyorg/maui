<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SampleNav"
             x:DataType="local:LoginViewModel"
             x:Class="SampleNav.LoginPage"
             Title="Login">

    <VerticalStackLayout Padding="20" Spacing="10" VerticalOptions="Center">
        <Label Text="Login" FontSize="24" HorizontalOptions="Center" />
        <Label Text="SwitchRoot replaced the entire window page. RestoreRoot brings the flyout/tabs back."
               FontSize="12"
               TextColor="Gray" />
        <Button Text="Sign in" Command="{Binding SignIn}" />
    </VerticalStackLayout>
</ContentPage>
