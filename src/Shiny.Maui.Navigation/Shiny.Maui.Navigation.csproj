<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework);$(BaseTargetFramework)-android;$(BaseTargetFramework)-ios;$(BaseTargetFramework)-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(BaseTargetFramework)-windows10.0.19041.0</TargetFrameworks>
        <RootNamespace>Shiny</RootNamespace>
        <EnableDefaultMauiMacCatalystTarget>false</EnableDefaultMauiMacCatalystTarget>
        <Description>Shiny MAUI Navigation - ViewModel-first navigation, tabs, and flyouts for .NET MAUI without Shell</Description>
        <PackageProjectUrl>https://shinylib.net/mauinav</PackageProjectUrl>
        <PackageReleaseNotes>https://shinylib.net/mauinav/release-notes/</PackageReleaseNotes>
        <PackageTags>maui shiny navigation tabs flyout</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <ProjectReference Include="..\Shiny.Maui.Core\Shiny.Maui.Core.csproj" />
    </ItemGroup>

</Project>
